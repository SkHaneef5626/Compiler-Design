    {
      "cell_type": "code",
      "source": [
        "%%writefile electricity.l\n",
        "%{\n",
        "#include <stdio.h>\n",
        "#include <stdlib.h>\n",
        "\n",
        "int total_consumers = 0;\n",
        "int low = 0;\n",
        "int medium = 0;\n",
        "int high = 0;\n",
        "int total_units = 0;\n",
        "%}\n",
        "\n",
        "%%\n",
        "[A-Za-z0-9]+[ \\t]+[0-9]+ {\n",
        "    char *p = yytext;\n",
        "\n",
        "    while (*p != ' ' && *p != '\\t')\n",
        "        p++;\n",
        "\n",
        "    while (*p == ' ' || *p == '\\t')\n",
        "        p++;\n",
        "\n",
        "    int units = atoi(p);\n",
        "\n",
        "    total_consumers++;\n",
        "    total_units += units;\n",
        "\n",
        "    if (units <= 100)\n",
        "        low++;\n",
        "    else if (units <= 300)\n",
        "        medium++;\n",
        "    else\n",
        "        high++;\n",
        "}\n",
        "\n",
        "\\n ;\n",
        ". ;\n",
        "%%\n",
        "\n",
        "int main()\n",
        "{\n",
        "    yylex();\n",
        "\n",
        "    printf(\"Total Consumers : %d\\n\", total_consumers);\n",
        "    printf(\"Low Usage Consumers : %d\\n\", low);\n",
        "    printf(\"Medium Usage Consumers : %d\\n\", medium);\n",
        "    printf(\"High Usage Consumers : %d\\n\", high);\n",
        "    printf(\"Total Units Consumed : %d\\n\", total_units);\n",
        "    printf(\"Average Units : %.2f\\n\",\n",
        "           (float)total_units / total_consumers);\n",
        "\n",
        "    return 0;\n",
        "}\n",
        "\n",
        "int yywrap()\n",
        "{\n",
        "    return 1;\n",
        "}"
