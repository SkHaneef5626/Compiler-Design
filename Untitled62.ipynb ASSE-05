      "source": [
        "%%writefile marks.l\n",
        "%{\n",
        "#include <stdio.h>\n",
        "#include <stdlib.h>\n",
        "\n",
        "int total_students = 0;\n",
        "int passed = 0;\n",
        "int failed = 0;\n",
        "int total_marks = 0;\n",
        "%}\n",
        "\n",
        "%%\n",
        "[A-Za-z0-9]+[ \\t]+[0-9]+ {\n",
        "    char *p = yytext;\n",
        "\n",
        "    while (*p != ' ' && *p != '\\t')\n",
        "        p++;\n",
        "\n",
        "    while (*p == ' ' || *p == '\\t')\n",
        "        p++;\n",
        "\n",
        "    int marks = atoi(p);\n",
        "\n",
        "    total_students++;\n",
        "    total_marks += marks;\n",
        "\n",
        "    if (marks >= 50)\n",
        "        passed++;\n",
        "    else\n",
        "        failed++;\n",
        "}\n",
        "\n",
        "\\n ;\n",
        ". ;\n",
        "%%\n",
        "\n",
        "int main()\n",
        "{\n",
        "    yylex();\n",
        "\n",
        "    printf(\"Total Students : %d\\n\", total_students);\n",
        "    printf(\"Passed Students : %d\\n\", passed);\n",
        "    printf(\"Failed Students : %d\\n\", failed);\n",
        "    printf(\"Average Marks : %.1f\\n\",\n",
        "           (float)total_marks / total_students);\n",
        "\n",
        "    return 0;\n",
        "}\n",
        "\n",
        "int yywrap()\n",
        "{\n",
        "    return 1;\n",
        "}"
